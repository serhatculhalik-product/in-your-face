# Each OAuth client ID must start with its matching numeric project number and a hyphen.
GOOGLE_OAUTH_CLIENT_ID='paste-your-public-project-number-and-client-id-here'
GOOGLE_OAUTH_CLIENT_SECRET='paste-your-desktop-client-secret-here'
GOOGLE_CLOUD_PROJECT_ID='paste-your-public-google-cloud-project-id-here'
GOOGLE_CLOUD_PROJECT_NUMBER='66553866962'

# Internal builds require a Desktop app credential from a distinct Google Cloud project.
INTERNAL_GOOGLE_OAUTH_CLIENT_ID='paste-your-internal-project-number-and-client-id-here'
INTERNAL_GOOGLE_OAUTH_CLIENT_SECRET='paste-your-internal-desktop-client-secret-here'
INTERNAL_GOOGLE_CLOUD_PROJECT_ID='paste-your-internal-google-cloud-project-id-here'
INTERNAL_GOOGLE_CLOUD_PROJECT_NUMBER='paste-your-internal-numeric-google-cloud-project-number-here'

# Distributed builds may provide a stable signing identity.
# CODE_SIGN_IDENTITY='Developer ID Application: Example (TEAMID)'
# INTERNAL_CODE_SIGN_IDENTITY='Apple Development: Example (TEAMID)'
